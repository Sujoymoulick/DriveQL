---
import Layout from '../../layouts/Layout.astro';
import { getPlatformDB } from '../../lib/db';
import { getEnv } from '../../lib/env';

const db = getPlatformDB(Astro.locals);
const user = await db.getOrCreateDefaultUser();
const accounts = await db.listGoogleAccounts(user.id);
const instances = await db.listInstances(user.id);
const env = getEnv(Astro.locals);

const totalCapacityBytes = accounts.reduce((sum, a) => sum + a.total_space_bytes, 0) || 16106127360;
const totalUsedBytes = accounts.reduce((sum, a) => sum + a.used_space_bytes, 0);
const usagePercent = Math.min(100, Math.round((totalUsedBytes / totalCapacityBytes) * 100));

const totalCapacityGb = Math.round((totalCapacityBytes / 1024 / 1024 / 1024) * 10) / 10;
const totalUsedGb = Math.round((totalUsedBytes / 1024 / 1024 / 1024) * 10) / 10;
const freeGb = Math.max(0, Math.round((totalCapacityGb - totalUsedGb) * 10) / 10);

const defaultInstance = instances[0] || null;
const appUrl = env.APP_URL.replace(/\/$/, '');
---

<Layout title="Dashboard" activeNav="dashboard">
  <!-- Top Welcome / Quick Action Bar -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.75rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.25rem;">
        <h1 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.025em;">
          Project Overview
        </h1>
        <span class="neon-badge neon-badge-green">Healthy</span>
      </div>
      <p style="color: var(--neon-text-secondary); font-size: 0.875rem;">
        Serverless PostgreSQL virtualized over Google Drive with edge PGlite runtime.
      </p>
    </div>

    <div style="display: flex; gap: 0.6rem;">
      <a href="/dashboard/accounts" class="neon-btn neon-btn-secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
        Drive Pool ({accounts.length})
      </a>
      {defaultInstance && (
        <a href={`/dashboard/instances/${defaultInstance.id}/studio`} class="neon-btn neon-btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          Open SQL Editor
        </a>
      )}
    </div>
  </div>

  <!-- Signature Neon Connection Details Card -->
  <div class="neon-card" style="margin-bottom: 1.5rem; background: #0c0e12; border-color: var(--neon-border); position: relative; overflow: hidden;">
    <!-- Subtle Neon Green top accent line -->
    <div style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, #00e599, transparent 80%);"></div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; align-items: center; gap: 0.6rem;">
        <span style="font-size: 0.875rem; font-weight: 600;">Connection Details</span>
        <span class="neon-badge neon-badge-gray" style="font-size: 0.7rem;">Postgres 16</span>
      </div>

      <!-- Protocol Selector -->
      <div style="display: flex; gap: 0.35rem; font-size: 0.75rem;">
        <button class="neon-btn neon-btn-secondary conn-pill active" data-type="uri" style="font-size: 0.7rem; padding: 0.2rem 0.55rem; border-color: var(--neon-green); color: #fff;">
          Postgres URI
        </button>
        <button class="neon-btn neon-btn-secondary conn-pill" data-type="psql" style="font-size: 0.7rem; padding: 0.2rem 0.55rem;">
          psql CLI
        </button>
        <button class="neon-btn neon-btn-secondary conn-pill" data-type="rest" style="font-size: 0.7rem; padding: 0.2rem 0.55rem;">
          HTTP / REST API
        </button>
      </div>
    </div>

    <!-- Connection String Box with Copy & Mask Toggle -->
    <div style="display: flex; align-items: center; background: #07080a; border: 1px solid var(--neon-border); border-radius: 6px; padding: 0.5rem 0.85rem; gap: 0.75rem;">
      <code id="connectionStringDisplay" style="flex: 1; font-family: var(--font-mono); font-size: 0.8125rem; color: #e4e4e7; overflow-x: auto; white-space: nowrap;">
        postgresql://postgres:••••••••••••@127.0.0.1:5432/driveql?sslmode=disable
      </code>

      <div style="display: flex; align-items: center; gap: 0.45rem;">
        <button id="togglePasswordBtn" class="neon-btn neon-btn-secondary" style="font-size: 0.7rem; padding: 0.25rem 0.55rem;" title="Show/Hide Token">
          Show
        </button>
        <button id="copyConnBtn" class="neon-btn neon-btn-primary" style="font-size: 0.7rem; padding: 0.25rem 0.65rem;">
          Copy
        </button>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem; font-size: 0.75rem; color: var(--neon-text-muted);">
      <span>Default role: <strong style="color: var(--neon-text-secondary);">postgres</strong> • Port: <strong style="color: var(--neon-text-secondary);">5432</strong> (via local bridge)</span>
      <span style="color: var(--neon-green);">Zero connection limits</span>
    </div>
  </div>

  <!-- Telemetry Gauges Grid (Neon Style) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
    <!-- Storage Gauge -->
    <div class="neon-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <span style="font-size: 0.75rem; font-weight: 600; color: var(--neon-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">POOLED STORAGE</span>
        <span class="neon-badge neon-badge-blue">{accounts.length} Google Drives</span>
      </div>
      <div style="font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.02em;">
        {totalUsedGb} GB <span style="font-size: 0.875rem; color: var(--neon-text-muted); font-weight: 400;">/ {totalCapacityGb} GB</span>
      </div>
      <!-- Neon Progress Bar -->
      <div style="width: 100%; height: 5px; background: rgba(255,255,255,0.06); border-radius: 9999px; overflow: hidden; margin-bottom: 0.5rem;">
        <div style={`width: ${usagePercent}%; height: 100%; background: #00e599; box-shadow: 0 0 8px rgba(0, 229, 153, 0.4); border-radius: 9999px;`}></div>
      </div>
      <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--neon-text-muted);">
        <span>{usagePercent}% allocated</span>
        <span style="color: var(--neon-green);">{freeGb} GB available</span>
      </div>
    </div>

    <!-- Compute Gauge -->
    <div class="neon-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <span style="font-size: 0.75rem; font-weight: 600; color: var(--neon-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">EDGE COMPUTE</span>
        <span class="neon-badge neon-badge-green">0ms Cold Start</span>
      </div>
      <div style="font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.02em;">
        0.25 CU <span style="font-size: 0.875rem; color: var(--neon-green); font-weight: 500;">(Autoscaling)</span>
      </div>
      <p style="font-size: 0.75rem; color: var(--neon-text-muted); margin-bottom: 0.5rem;">
        PGlite WebAssembly runtime running on Cloudflare Workers edge network.
      </p>
      <div style="font-size: 0.75rem; color: var(--neon-text-secondary); display: flex; align-items: center; gap: 0.35rem;">
        <span style="width: 5px; height: 5px; border-radius: 50%; background: var(--neon-green);"></span>
        <span>ACID Compliant • WAL streaming enabled</span>
      </div>
    </div>

    <!-- Database Instances -->
    <div class="neon-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <span style="font-size: 0.75rem; font-weight: 600; color: var(--neon-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">ACTIVE DATABASES</span>
        <span class="neon-badge neon-badge-gray">Port 5432 / HTTP</span>
      </div>
      <div style="font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.02em;">
        {instances.length}
      </div>
      <p style="font-size: 0.75rem; color: var(--neon-text-muted); margin-bottom: 0.5rem;">
        Isolated relational volumes hosted on separate Google Drive sandboxes.
      </p>
      <div style="font-size: 0.75rem; color: var(--neon-text-secondary);">
        <a href="/dashboard/instances" style="color: var(--neon-green); font-weight: 500;">+ Provision another database →</a>
      </div>
    </div>
  </div>

  <!-- Databases Table (Neon Style) -->
  <div class="neon-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--neon-border); display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h2 style="font-size: 1rem; font-weight: 700;">Database Instances</h2>
        <p style="font-size: 0.75rem; color: var(--neon-text-muted);">All active PostgreSQL instances queryable from your edge panel.</p>
      </div>
      <a href="/dashboard/instances" class="neon-btn neon-btn-secondary" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">
        View All
      </a>
    </div>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.8125rem;">
        <thead>
          <tr style="border-bottom: 1px solid var(--neon-border); background: #0c0d10; color: var(--neon-text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
            <th style="padding: 0.65rem 1.25rem;">Database</th>
            <th style="padding: 0.65rem 1.25rem;">Status</th>
            <th style="padding: 0.65rem 1.25rem;">Host Drive</th>
            <th style="padding: 0.65rem 1.25rem;">Allocated Volume</th>
            <th style="padding: 0.65rem 1.25rem;">Current Size</th>
            <th style="padding: 0.65rem 1.25rem;">Last Sync</th>
            <th style="padding: 0.65rem 1.25rem; text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          {instances.map((inst) => {
            const currentSizeMb = Math.round((inst.current_size_bytes / 1024 / 1024) * 100) / 100;
            const quotaGb = Math.round((inst.allocated_quota_bytes / 1024 / 1024 / 1024) * 10) / 10;
            const matchAcc = accounts.find((a) => a.id === inst.google_account_id);

            return (
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.03); transition: background 0.1s ease;">
                <td style="padding: 0.85rem 1.25rem;">
                  <a href={`/dashboard/instances/${inst.id}`} style="font-weight: 600; color: #fff;">
                    {inst.name}
                  </a>
                  <div style="font-size: 0.7rem; color: var(--neon-text-muted); font-family: var(--font-mono);">
                    {inst.id}
                  </div>
                </td>
                <td style="padding: 0.85rem 1.25rem;">
                  <span class="neon-badge neon-badge-green">{inst.status}</span>
                </td>
                <td style="padding: 0.85rem 1.25rem; color: var(--neon-text-secondary); font-size: 0.75rem;">
                  {matchAcc?.google_email || 'Mapped Drive'}
                </td>
                <td style="padding: 0.85rem 1.25rem; font-weight: 500;">
                  {quotaGb} GB
                </td>
                <td style="padding: 0.85rem 1.25rem; font-family: var(--font-mono); color: var(--neon-cyan);">
                  {currentSizeMb < 0.1 ? `${Math.round(inst.current_size_bytes / 1024)} KB` : `${currentSizeMb} MB`}
                </td>
                <td style="padding: 0.85rem 1.25rem; color: var(--neon-text-muted); font-size: 0.75rem;">
                  {inst.last_synced_at ? new Date(inst.last_synced_at).toLocaleTimeString() : 'Recent'}
                </td>
                <td style="padding: 0.85rem 1.25rem; text-align: right;">
                  <a href={`/dashboard/instances/${inst.id}/studio`} class="neon-btn neon-btn-primary" style="font-size: 0.75rem; padding: 0.3rem 0.7rem;">
                    SQL Editor
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline define:vars={{ defaultInstanceId: defaultInstance?.id || 'dql_demo_db', appUrl }}>
    const display = document.getElementById('connectionStringDisplay');
    const toggleBtn = document.getElementById('togglePasswordBtn');
    const copyBtn = document.getElementById('copyConnBtn');
    let isMasked = true;
    let currentProtocol = 'uri';

    const connFormats = {
      uri: {
        masked: 'postgresql://postgres:••••••••••••@127.0.0.1:5432/driveql?sslmode=disable',
        unmasked: 'postgresql://postgres:dql_live_demo_key@127.0.0.1:5432/driveql?sslmode=disable',
      },
      psql: {
        masked: 'psql -h 127.0.0.1 -p 5432 -U postgres -d driveql',
        unmasked: 'psql -h 127.0.0.1 -p 5432 -U postgres -d driveql',
      },
      rest: {
        masked: `curl -X POST "${appUrl}/api/instances/${defaultInstanceId}/query" -H "Authorization: Bearer ••••••••"`,
        unmasked: `curl -X POST "${appUrl}/api/instances/${defaultInstanceId}/query" -H "Authorization: Bearer dql_live_demo_key"`,
      }
    };

    function updateConnString() {
      if (display) {
        display.innerText = isMasked ? connFormats[currentProtocol].masked : connFormats[currentProtocol].unmasked;
      }
      if (toggleBtn) {
        toggleBtn.innerText = isMasked ? 'Show' : 'Hide';
      }
    }

    if (toggleBtn) {
      toggleBtn.onclick = () => {
        isMasked = !isMasked;
        updateConnString();
      };
    }

    if (copyBtn) {
      copyBtn.onclick = () => {
        const text = connFormats[currentProtocol].unmasked;
        navigator.clipboard.writeText(text);
        copyBtn.innerText = 'Copied!';
        copyBtn.style.background = '#00c885';
        setTimeout(() => {
          copyBtn.innerText = 'Copy';
          copyBtn.style.background = 'var(--neon-green)';
        }, 1500);
      };
    }

    document.querySelectorAll('.conn-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.conn-pill').forEach(b => {
          b.style.borderColor = 'var(--neon-border)';
          b.style.color = 'var(--neon-text-primary)';
        });
        btn.style.borderColor = 'var(--neon-green)';
        btn.style.color = '#fff';
        currentProtocol = btn.getAttribute('data-type') || 'uri';
        updateConnString();
      });
    });
  </script>
</Layout>
