---
import Layout from '../../layouts/Layout.astro';
import { getPlatformDB } from '../../lib/db';
import { getEnv } from '../../lib/env';

const db = getPlatformDB(Astro.locals);
const user = await db.getOrCreateDefaultUser();
const accounts = await db.listGoogleAccounts(user.id);
const env = getEnv(Astro.locals);

const isConfigured = Boolean(env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET);
const url = new URL(Astro.request.url);
const isConnectedSuccess = url.searchParams.get('connected') === 'true';
const errorMsg = url.searchParams.get('error');

const totalBytes = accounts.reduce((sum, a) => sum + a.total_space_bytes, 0);
const usedBytes = accounts.reduce((sum, a) => sum + a.used_space_bytes, 0);
const totalGb = Math.round((totalBytes / 1024 / 1024 / 1024) * 10) / 10;
const usedGb = Math.round((usedBytes / 1024 / 1024 / 1024) * 10) / 10;
const freeGb = Math.max(0, Math.round((totalGb - usedGb) * 10) / 10);
const usagePercent = totalBytes ? Math.min(100, Math.round((usedBytes / totalBytes) * 100)) : 0;
---

<Layout title="Drive Storage Pool" activeNav="accounts">
  <!-- Top Header -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.25rem;">
        <h1 style="font-size: 1.75rem; font-weight: 700; letter-spacing: -0.025em;">
          Google Drive Storage Pool
        </h1>
        <span class="neon-badge neon-badge-blue">{accounts.length} Drives Linked</span>
      </div>
      <p style="color: var(--neon-text-secondary); font-size: 0.875rem;">
        Aggregate 15 GB free storage allocations across multiple Google accounts into virtualized database volumes.
      </p>
    </div>

    <div style="display: flex; gap: 0.65rem;">
      <button id="addMockBtn" class="neon-btn neon-btn-secondary" style="border-color: var(--neon-cyan); color: var(--neon-cyan);">
        🧪 + Add Test Drive (15 GB)
      </button>

      {isConfigured ? (
        <a href="/api/auth/google/connect" class="neon-btn neon-btn-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
          Connect Live Drive
        </a>
      ) : (
        <a href="/docs#google-setup" class="neon-btn neon-btn-secondary" style="border-color: var(--neon-amber); color: #fbbf24;">
          ⚠️ Configure Live Google OAuth
        </a>
      )}
    </div>
  </div>

  {isConnectedSuccess && (
    <div style="background: rgba(0, 229, 153, 0.08); border: 1px solid rgba(0, 229, 153, 0.25); border-radius: 6px; padding: 0.85rem 1.25rem; margin-bottom: 1.5rem; color: var(--neon-green); display: flex; align-items: center; justify-content: space-between; font-size: 0.875rem;">
      <span>✓ Google Drive account linked successfully! Added 15 GB to your storage pool.</span>
      <a href="/dashboard/instances" class="neon-btn neon-btn-primary" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">
        Create Database →
      </a>
    </div>
  )}

  {errorMsg && (
    <div style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: 6px; padding: 0.85rem 1.25rem; margin-bottom: 1.5rem; color: #f87171; font-size: 0.875rem;">
      ✕ Connection Error: {decodeURIComponent(errorMsg)}
    </div>
  )}

  <!-- Aggregate Pool Summary Card -->
  <div class="neon-card" style="margin-bottom: 2rem; background: #0c0e12; border-color: var(--neon-border); position: relative; overflow: hidden;">
    <div style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, #00b8ff, #00e599, transparent 80%);"></div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
      <div>
        <span style="font-size: 0.75rem; font-weight: 600; color: var(--neon-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">AGGREGATE STORAGE CAPACITY</span>
        <div style="font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 0.25rem;">
          {usedGb} GB <span style="font-size: 1rem; color: var(--neon-text-muted); font-weight: 400;">/ {totalGb} GB</span>
        </div>
      </div>

      <div style="text-align: right;">
        <span class="neon-badge neon-badge-green" style="font-size: 0.8125rem;">{freeGb} GB Free Pool</span>
        <div style="font-size: 0.75rem; color: var(--neon-text-muted); margin-top: 0.35rem;">
          {accounts.length} linked accounts • Zero cost
        </div>
      </div>
    </div>

    <!-- Storage Bar -->
    <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.06); border-radius: 9999px; overflow: hidden; margin-bottom: 0.6rem;">
      <div style={`width: ${usagePercent}%; height: 100%; background: linear-gradient(90deg, #00b8ff, #00e599); border-radius: 9999px; box-shadow: 0 0 8px rgba(0, 229, 153, 0.4);`}></div>
    </div>

    <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--neon-text-muted);">
      <span>{usagePercent}% total pool allocated</span>
      <span>15 GB included per connected Google account</span>
    </div>
  </div>

  <!-- Connected Accounts Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;">
    {accounts.length === 0 ? (
      <div class="neon-card" style="grid-column: 1 / -1; text-align: center; padding: 4rem 1.5rem; border: 1px dashed var(--neon-border);">
        <div style="font-size: 2rem; margin-bottom: 0.75rem; opacity: 0.6;">☁️</div>
        <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 0.35rem;">No Google Accounts Connected</h3>
        <p style="color: var(--neon-text-secondary); font-size: 0.875rem; max-width: 480px; margin: 0 auto 1.5rem;">
          Connect personal, student, or organizational Google Drive accounts to harvest their idle 15 GB storage.
        </p>
        <button id="addMockBtn2" class="neon-btn neon-btn-primary">
          🧪 Add Test Drive Account (15 GB)
        </button>
      </div>
    ) : (
      accounts.map((acc) => {
        const accTotalGb = Math.round((acc.total_space_bytes / 1024 / 1024 / 1024) * 10) / 10;
        const accUsedGb = Math.round((acc.used_space_bytes / 1024 / 1024 / 1024) * 10) / 10;
        const accFreeGb = Math.max(0, Math.round((accTotalGb - accUsedGb) * 10) / 10);
        const percent = Math.min(100, Math.round((acc.used_space_bytes / acc.total_space_bytes) * 100));

        return (
          <div class="neon-card" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.65rem;">
                  <div style="width: 34px; height: 34px; border-radius: 6px; background: rgba(0, 184, 255, 0.1); border: 1px solid rgba(0, 184, 255, 0.25); display: flex; align-items: center; justify-content: center; font-size: 1rem;">
                    📁
                  </div>
                  <div>
                    <div style="font-weight: 600; font-size: 0.9375rem; color: #fff;">{acc.google_email}</div>
                    <div style="font-size: 0.7rem; color: var(--neon-text-muted); font-family: var(--font-mono);">{acc.id}</div>
                  </div>
                </div>
                <span class="neon-badge neon-badge-green">Ready</span>
              </div>

              <!-- Storage Bar -->
              <div style="margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 0.35rem;">
                  <span style="color: var(--neon-text-secondary);">Drive Quota</span>
                  <span style="font-weight: 600; font-family: var(--font-mono);">{accUsedGb} GB / {accTotalGb} GB</span>
                </div>
                <div style="width: 100%; height: 5px; background: rgba(255,255,255,0.06); border-radius: 9999px; overflow: hidden;">
                  <div style={`width: ${percent}%; height: 100%; background: #00e599; border-radius: 9999px;`}></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--neon-text-muted); margin-top: 0.35rem;">
                  <span>{percent}% used</span>
                  <span style="color: var(--neon-green);">{accFreeGb} GB available</span>
                </div>
              </div>
            </div>

            <div style="border-top: 1px solid var(--neon-border); padding-top: 0.85rem; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.75rem; color: var(--neon-text-muted);">
                Linked {new Date(acc.created_at).toLocaleDateString()}
              </span>
              <button 
                class="neon-btn neon-btn-danger" 
                style="font-size: 0.75rem; padding: 0.25rem 0.6rem;"
                onclick={`unlinkAccount('${acc.id}')`}
              >
                Unlink
              </button>
            </div>
          </div>
        );
      })
    )}
  </div>

  <!-- Neon Security & Privacy Callout -->
  <div class="neon-card" style="background: #090a0d; border-color: var(--neon-border);">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--neon-green)" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      <h3 style="font-size: 0.9375rem; font-weight: 600;">Secure, Scoped Storage Architecture</h3>
    </div>
    <p style="font-size: 0.8125rem; color: var(--neon-text-secondary); line-height: 1.6; margin-bottom: 0.85rem;">
      DriveQL exclusively requests the <code style="color: var(--neon-cyan); font-family: var(--font-mono); font-size: 0.75rem;">https://www.googleapis.com/auth/drive.file</code> scope. It can only read and write files it created in its own isolated database directory. All refresh tokens are stored encrypted via hardware-accelerated AES-256-GCM.
    </p>
    <div style="display: flex; gap: 1.25rem; flex-wrap: wrap; font-size: 0.75rem;">
      <span style="color: var(--neon-green);">✓ Zero access to user documents</span>
      <span style="color: var(--neon-green);">✓ AES-256-GCM Token Vault</span>
      <span style="color: var(--neon-green);">✓ Google CASA audit exempt</span>
    </div>
  </div>

  <script is:inline>
    const addMockBtn = document.getElementById('addMockBtn');
    const addMockBtn2 = document.getElementById('addMockBtn2');

    function attachMockHandler(btn) {
      if (!btn) return;
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.innerText = 'Adding 15 GB Drive...';
        try {
          const res = await fetch('/api/accounts/mock', { method: 'POST' });
          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert('Failed: ' + (data.error || 'Unknown error'));
          }
        } catch (e) {
          alert('Error: ' + e.message);
        } finally {
          btn.disabled = false;
          btn.innerText = '🧪 + Add Test Drive (15 GB)';
        }
      });
    }

    attachMockHandler(addMockBtn);
    attachMockHandler(addMockBtn2);

    async function unlinkAccount(accountId) {
      if (!confirm('Unlink this Google Drive account? Databases mapped to this volume must be reassigned.')) {
        return;
      }
      try {
        const res = await fetch('/api/accounts', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ accountId }),
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert('Error: ' + (data.error || 'Failed'));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }
  </script>
</Layout>
